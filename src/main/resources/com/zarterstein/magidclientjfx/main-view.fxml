<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="800" prefWidth="800" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.zarterstein.magidclientjfx.MagidMainController">
    <stylesheets>
        <URL value="@common-styles/fx.utility.css" />
    </stylesheets>
   <Pane prefHeight="34.0" prefWidth="800.0">
      <children>
           <Button onAction="#onReloadServerXmlClick" text="Reset server">
            <styleClass>
               <String fx:value="rounded-4" />
               <String fx:value="bg-rounded-4" />
               <String fx:value="bg-amber-100" />
               <String fx:value="cursor-hand" />
               <String fx:value="text-sky-700" />
            </styleClass></Button>
           <Button layoutX="88.0" onAction="#onEstablishConnectionClick" text="Connect to the Server">
            <styleClass>
               <String fx:value="bg-amber-200" />
               <String fx:value="bg-rounded-4" />
               <String fx:value="rounded-4" />
               <String fx:value="text-sky-700" />
            </styleClass></Button>
         <Button layoutX="742.0" mnemonicParsing="false" onAction="#showOptionsMenu" text="Options">
            <styleClass>
               <String fx:value="rounded-4" />
               <String fx:value="bg-rounded-4" />
               <String fx:value="bg-amber-400" />
               <String fx:value="text-sky-700" />
               <String fx:value="cursor-hand" />
            </styleClass></Button>
         <Label fx:id="statusLabel" layoutX="232.0" layoutY="4.0" prefHeight="17.0" prefWidth="446.0" />
      </children>
   </Pane>
    <Pane fx:id="effectPane" prefHeight="802.0" prefWidth="800.0">
        <Pane fx:id="responsePane" prefHeight="500.0" />
    </Pane>
</VBox>
